/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests with a Clustal-formatted alignment
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same dataset as the default test profile, but exercises the Clustal branch of the
    EMBOSS_SEQRET alignment-format normalisation step.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test_clustal,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // The near-empty fixture sequences crash RAxML-NG's default branch-length optimisation (BRLEN out-of-bounds) for some seeds.
    withName: 'RAXMLNG_SEARCH' {
        ext.args = { "--blopt nr_safe --seed ${params.raxmlng_seed}" }
    }
}

params {
    config_profile_name        = 'Clustal test profile'
    config_profile_description = 'Minimal test dataset (Clustal alignment) to check pipeline function'

    // Input data
    taxonomy  = params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_test.tax'
    sequences = params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_test.aln'

    // See conf/test.config for why: this fixture is too sparse for raxtax's
    // self-classification to survive at the default rank.
    skip_raxtax = true

    // See conf/test.config for why: this fixture is too sparse to survive the
    // default min_nongap threshold either.
    skip_gapfilter = true
}
