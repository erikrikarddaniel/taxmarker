/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'All archaeal 16S sequences from GTDB r226 to check pipeline function at scale'

    // GTDB distributes both domains' 16S sequences in one file; --seqgrep restricts
    // it to Archaea by matching GTDB's own `d__Archaea` rank-prefix text.
    sequences = 'https://data.gtdb.ecogenomic.org/releases/release226/226.0/genomic_files_all/ssu_all_r226.fna.gz'
    seqgrep   = 'd__Archaea'

    // Real GTDB sequences aren't pre-aligned to this pipeline's own profile --
    // hmmalign against Barrnap's archaeal rRNA HMM database aligns them.
    hmm      = params.pipelines_testdata_base_path + 'taxmarker/testdata/barrnap_arc.hmm'
    hmm_name = '16S_rRNA'
}
