nextflow_process {

    name "Test Process EXPORTREFERENCE"
    script "../main.nf"
    process "EXPORTREFERENCE"

    tag "modules"
    tag "modules_local"
    tag "taxmarker"
    tag "taxmarker/exportreference"

    test("weight x length ranking, verdicts inherited by cluster members") {

        when {
            process {
                """
                def dir = file("\${workDir}/exportreference_fixture")
                dir.mkdirs()
                def X = 'd__Bacteria;p__P;c__C;o__O;f__F;g__Gx;s__Gx alpha'
                def Y = 'd__Bacteria;p__P;c__C;o__O;f__F;g__Hy;s__beta'
                def names = ['X_C', 'X_A', 'X_B', 'X_M', 'X_F', 'X_Fm', 'X_U', 'X_Um', 'Y_1']
                def seqs = file("\${dir}/input.fna")
                seqs.text = names.collect { n -> ">RS_\${n.replace('_', '~')} original description of \${n}\\nAC-GT\\n" }.join('')
                def tax = file("\${dir}/checked.tax")
                tax.text = names.collect { n -> "RS_\${n}\\t\${n.startsWith('Y') ? Y : X}\\n" }.join('')
                def sel = file("\${dir}/selection.tsv")
                sel.text = 'cluster_id\\ttaxon\\tseq_name\\tlength\\tweight\\tscore\\tis_representative\\n' + [
                    // weight x length: X_C 225 > X_A 200 > X_M 190 > X_B 160.
                    // Weight alone would rank X_A first, length alone X_B.
                    [1, X, 'RS_X_C',  150, 1.5, 'True'],
                    [2, X, 'RS_X_A',  100, 2.0, 'True'],
                    [2, X, 'RS_X_M',  100, 1.9, 'False'],
                    [3, X, 'RS_X_B',  160, 1.0, 'True'],
                    // Flagged representative: it and its member are out.
                    [4, X, 'RS_X_F',  200, 5.0, 'True'],
                    [4, X, 'RS_X_Fm', 200, 5.0, 'False'],
                    // Representative dropped before the last step: unverified, out.
                    [5, X, 'RS_X_U',  200, 5.0, 'True'],
                    [5, X, 'RS_X_Um', 200, 5.0, 'False'],
                    [6, Y, 'RS_Y_1',  100, 1.0, 'True'],
                ].collect { c, t, n, l, w, r -> "\${c}\\t\${t}\\t\${n}\\t\${l}\\t\${w}\\t0\\t\${r}\\n" }.join('')
                def verified = file("\${dir}/verified.tax")
                verified.text = ['X_C', 'X_A', 'X_B', 'X_F', 'Y_1'].collect { n -> "RS_\${n}\\t\${n.startsWith('Y') ? Y : X}\\n" }.join('')
                def mis = file("\${dir}/mislabels.tsv")
                mis.text = 'seq_name\\toriginal_label\\tpredicted_label\\tlwr\\tmismatch_rank\\tmethod\\n' +
                    "RS_X_F\\t\${X}\\t\${Y}\\t1.0\\t7\\tsativa\\n"
                input[0] = [ [ id:'export_test' ], seqs, tax, sel, verified, mis ]
                input[1] = [ 1, 3 ]
                """
            }
        }

        then {
            assert process.success

            def read = { name -> path(process.out.general[0][1].find { it.toString().endsWith(name) }).linesGzip }
            def readAs = { ch, name -> path(ch[0][1].find { it.toString().endsWith(name) }).linesGzip }
            def general1 = read('.n1.general.fna.gz')
            def general3 = read('.n3.general.fna.gz')
            def add1     = readAs(process.out.addspecies, '.n1.addSpecies.fna.gz')
            def assign1  = readAs(process.out.assigntaxonomy, '.n1.assignTaxonomy.fna.gz')

            assertAll(
                // Top 1 of species X by weight x length, and the only one of Y.
                { assert general1.findAll { it.startsWith('>') } == [
                    '>RS_X~C original description of X_C',
                    '>RS_Y~1 original description of Y_1',
                ] },
                // Top 3: the member X_M inherits its representative's verdict.
                { assert general3.findAll { it.startsWith('>') }.collect { it.tokenize(' ')[0] } == [
                    '>RS_X~C', '>RS_X~A', '>RS_X~M', '>RS_Y~1',
                ] },
                { assert general1[1] == 'ACGT' },
                // A species name not starting with its genus gets the genus prepended.
                { assert add1.findAll { it.startsWith('>') } == [ '>RS_X~C Gx alpha', '>RS_Y~1 Hy beta' ] },
                { assert assign1.findAll { it.startsWith('>') } == [
                    '>Bacteria;P;C;O;F;Gx;Gx alpha',
                    '>Bacteria;P;C;O;F;Hy;beta',
                ] },
            )
        }

    }

    test("without clustering: every sequence is its own representative, ranked by length") {

        when {
            process {
                """
                def dir = file("\${workDir}/exportreference_noclust")
                dir.mkdirs()
                def Z = 'd__Bacteria;p__P;g__Gz;s__Gz zeta'
                def seqs = file("\${dir}/input.fna")
                seqs.text = '>Z_short\\nACGT\\n>Z_long\\nACGTACGT\\n>Z_flagged\\nACGTACGTACGT\\n'
                def tax = file("\${dir}/checked.tax")
                tax.text = ['Z_short', 'Z_long', 'Z_flagged'].collect { n -> "\${n}\\t\${Z}\\n" }.join('')
                def mis = file("\${dir}/mislabels.tsv")
                mis.text = 'seq_name\\toriginal_label\\tpredicted_label\\tlwr\\tmismatch_rank\\tmethod\\n' +
                    "Z_flagged\\t\${Z}\\t\${Z}\\t1.0\\t4\\tsativa\\n"
                input[0] = [ [ id:'export_test' ], seqs, tax, [], tax, mis ]
                input[1] = [ 1 ]
                """
            }
        }

        then {
            assert process.success
            def general1 = path(process.out.general[0][1]).linesGzip
            assert general1.findAll { it.startsWith('>') } == [ '>Z_long' ]
        }

    }

    test("taxa without genus and species are left out of addSpecies only") {

        when {
            process {
                """
                def dir = file("\${workDir}/exportreference_ranks")
                dir.mkdirs()
                def taxa = [
                    OK:     'd__Bacteria;f__F;g__Gz;s__Gz zeta',
                    EMPTYS: 'd__Bacteria;f__F;g__Gz;s__',
                    GENUS:  'd__Bacteria;f__F;g__Gz',
                    SINGLE: 'Bacteria',
                ]
                def seqs = file("\${dir}/input.fna")
                seqs.text = taxa.keySet().collect { n -> ">\${n}\\nACGT\\n" }.join('')
                def tax = file("\${dir}/checked.tax")
                tax.text = taxa.collect { n, t -> "\${n}\\t\${t}\\n" }.join('')
                input[0] = [ [ id:'export_test' ], seqs, tax, [], tax, [] ]
                input[1] = [ 1 ]
                """
            }
        }

        then {
            assert process.success
            def ids = { ch -> path(ch[0][1]).linesGzip.findAll { it.startsWith('>') } }
            assertAll(
                { assert ids(process.out.general).size() == 4 },
                { assert ids(process.out.addspecies) == [ '>OK Gz zeta' ] },
            )
        }

    }

    test("weight x length ranking - stub") {

        options "-stub"

        when {
            process {
                """
                def (seqs, tax) = ['input.fna', 'checked.tax'].collect { n -> def f = file("\${workDir}/\${n}"); f.text = ''; f }
                input[0] = [ [ id:'export_test' ], seqs, tax, [], tax, [] ]
                input[1] = [ 1, 5 ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
