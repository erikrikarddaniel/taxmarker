nextflow_process {

    name "Test Process RAXMLNG_MOOSE"
    script "../main.nf"
    config "./nextflow.config"
    process "RAXMLNG_MOOSE"

    tag "modules"
    tag "modules_local"
    tag "taxmarker"
    tag "raxmlng"
    tag "raxmlng/moose"

    // Three taxa of six tips and 400 sites, built inline.
    def inputs = """
        def rnd = new Random(1)
        def bases = ['A', 'C', 'G', 'T']
        def root = (1..400).collect { bases[rnd.nextInt(4)] }
        def seqs = [:]
        ['a', 'b', 'c'].each { taxon ->
            def ts = root.collect { c -> rnd.nextDouble() < 0.2 ? bases[rnd.nextInt(4)] : c }
            (1..6).each { i -> seqs[taxon + i] = ts.collect { c -> rnd.nextDouble() < 0.05 ? bases[rnd.nextInt(4)] : c }.join() }
        }
        def dir = java.nio.file.Files.createTempDirectory('moose').toFile()
        def aln = new File(dir, 'aln.fasta')
        aln.text = seqs.collect { name, s -> '>' + name + '\\n' + s + '\\n' }.join()
    """

    test("raxmlng/moose - model selection on random sequences") {

        when {
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()) ]
                """
            }
        }

        then {
            assert process.success

            def model = path(process.out.best_model[0][1]).text.trim()

            assertAll(
                // Random sequences carry no signal for rate variation or unequal frequencies, so the simplest model wins.
                // "<model>, <partition name> = <sites>": RAxML-NG's partition format, one partition named noname over all 400 sites.
                { assert model == 'F81+FE, noname = 1-400' },
                { assert path(process.out.log[0][1]).text.contains('Model selection') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("raxmlng/moose - stub") {

        options "-stub"

        when {
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
