nextflow_pipeline {

    name "Test pipeline with real GTDB archaeal 16S data"
    script "../main.nf"
    tag "pipeline"
    profile "test_gtdb"

    test("-profile test_gtdb, raxtax disabled") {

        when {
            params {
                outdir      = "$outputDir"
                skip_raxtax = true
            }
        }

        then {
            assert workflow.success

            def mislabels = path("$outputDir/mislabels/user-alignment.mislabels.tsv").text
            def summary   = path("$outputDir/sativaepang/user-alignment.summary.txt").text

            assertAll(
                // Every sequence goes through EPA-ng placement and scoring directly;
                // no raxtax step runs at all.
                { assert !new File("$outputDir/raxtaxformat").exists() },
                // DupHaloA/DupSulfoA is a deliberate swapped-label pair (maximally
                // divergent phyla) -- an unambiguous positive control that sativa-epang's
                // full phylogenetic placement must catch even without raxtax's help.
                { assert summary.contains('putative mislabels: 2') },
                { assert mislabels.contains('DupHaloA') },
                { assert mislabels.contains('DupSulfoA') },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml")).match("versions_raxtax_disabled") },
            )
        }

    }

    test("-profile test_gtdb, raxtax default (genus, confidence 0.9)") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success

            def mislabels = path("$outputDir/mislabels/user-alignment.mislabels.tsv").text

            assertAll(
                { assert new File("$outputDir/raxtaxformat").exists() },
                // The swapped-label pair disagrees with raxtax's self-classification at
                // every rank, so it's caught by raxtax directly -- never reaching EPA-ng.
                { assert mislabels =~ /DupHaloA[^\n]*\traxtax/ },
                { assert mislabels =~ /DupSulfoA[^\n]*\traxtax/ },
                // Haloferax prahovense's best raxtax hit is its sister species H.
                // volcanii: genus agrees, so it is not flagged at the default rank.
                { assert !(mislabels =~ /Haloferax prahovense[^\n]*\traxtax/) },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml")).match("versions_default_rank") },
            )
        }

    }

    test("-profile test_gtdb, raxtax species rank") {

        when {
            params {
                outdir                = "$outputDir"
                raxtax_filter_rank    = 1
                raxtax_min_confidence = 0
            }
        }

        then {
            assert workflow.success

            def mislabels = path("$outputDir/mislabels/user-alignment.mislabels.tsv").text

            assertAll(
                { assert mislabels =~ /DupHaloA[^\n]*\traxtax/ },
                { assert mislabels =~ /DupSulfoA[^\n]*\traxtax/ },
                // Species disagrees with its sister H. volcanii, so it is flagged at species rank.
                { assert mislabels =~ /Haloferax prahovense[^\n]*\traxtax/ },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml")).match("versions_species_rank") },
            )
        }

    }

    test("-profile test_gtdb, sativa skipped") {

        when {
            params {
                outdir      = "$outputDir"
                skip_sativa = true
            }
        }

        then {
            assert workflow.success

            def mislabels = path("$outputDir/mislabels/user-alignment.mislabels.tsv").text

            assertAll(
                // raxtax prefilter still runs as configured (default: on)...
                { assert new File("$outputDir/raxtaxformat").exists() },
                { assert mislabels =~ /DupHaloA[^\n]*\traxtax/ },
                { assert mislabels =~ /DupSulfoA[^\n]*\traxtax/ },
                // Only the swapped-label pair disagrees at genus with high confidence.
                { assert mislabels.readLines().size() - 1 == 2 },
                // ...but the phylogenetic placement subworkflow never runs at all: no
                // reference tree, no leave-one-out placement, no scoring. This is the
                // whole point of --skip_sativa -- a pure taxonomy-resolution/alignment/
                // prefilter QC run, without the much more expensive EPA-ng-based step.
                { assert !new File("$outputDir/taxonomytree").exists() },
                { assert !new File("$outputDir/raxmlng").exists() },
                // reference/looscore/misreport share the default sativaepang/ group;
                // lootasks/looplace each get their own explicit subdirectory (see
                // conf/modules.config -- both publish a *.l1o_tasks with the same name).
                { assert !new File("$outputDir/sativaepang").exists() },
                { assert !new File("$outputDir/sativaepang/lootasks").exists() },
                { assert !new File("$outputDir/sativaepang/looplace").exists() },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml")).match("versions_sativa_skipped") },
            )
        }

    }

    test("-profile test_gtdb, sativa and clustering both skipped") {

        when {
            params {
                outdir          = "$outputDir"
                skip_sativa     = true
                skip_clustering = true
            }
        }

        then {
            assert workflow.success

            def mislabels = path("$outputDir/mislabels/user-alignment.mislabels.tsv").text

            assertAll(
                { assert mislabels =~ /DupHaloA[^\n]*\traxtax/ },
                { assert mislabels =~ /DupSulfoA[^\n]*\traxtax/ },
                // Without clustering, Pyrococcus furiosus has three sequences, so it is
                // judged, and raxtax places all three in Methanocaldococcus.
                { assert mislabels.readLines().size() - 1 == 5 },
            )
        }

    }

}
